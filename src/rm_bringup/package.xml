<?xml version="1.0"?>
<package format="3">
  <name>rm_bringup</name>
  <version>0.0.0</version>
  <description>Canonical launch and robot profiles for the RM vision pipeline.</description>
  <maintainer email="chen.junn@outlook.com">chenjun</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>armor_detector</exec_depend>
  <exec_depend>armor_detector_nn</exec_depend>
  <exec_depend>auto_buff</exec_depend>
  <exec_depend>gimbal_pipeline</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mindvision_camera</exec_depend>
  <exec_depend>rm_robot_description</exec_depend>
  <exec_depend>rm_serial_driver</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros2_hik_camera</exec_depend>
  <exec_depend>video_player</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
